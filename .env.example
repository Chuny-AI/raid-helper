TOKEN=YOUR TOKEN BOT ID - https://discord.com/developers/applications/1285394679260647424/bot
CLIENT_ID=YOUR BOTS CLIENT ID - https://discord.com/developers/applications/1285394679260647424/oauth2
# El entorno lo decide GUILD_ID:
#   GUILD_ID definido     -> DESARROLLO: comandos solo en ese servidor
#   GUILD_ID vacio/sin el -> PRODUCCION: comandos globales

GUILD_ID=YOUR GUILD ID - CODIGO COPIADO DEL DISCORD
# Opcional en producción: publica los dos paneles de registro también en estos
# servidores para que aparezcan de inmediato. Separa varios IDs con comas.
REGISTRATION_COMMAND_GUILD_IDS=
# Una sola URI. Cada entorno apunta a su propia base desde su propio .env:
# desarrollo y produccion NUNCA deben compartir base.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nombre_de_la_base
BOT_OWNER_ID=YOUR_USER_ID
