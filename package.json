{
  "name": "chuny-bot",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env index.js",
    "destroy-node-instances": "taskkill /F /IM node.exe",
    "check-commands": "node --env-file=.env check-commands.js",
    "cli": "node --env-file=.env scripts/cli.js",
    "railway": "node index.js",
    "test:weapons": "node scripts/raid-weapon-config-smoke.js && node scripts/raid-config-panel-smoke.js",
    "test:all": "node scripts/raidstate-smoke.js && node scripts/render-smoke.js && node scripts/migration-smoke.js && node scripts/raidevent-schema-smoke.js && npm run test:weapons"
  },
  "keywords": [
    "discord",
    "bot",
    "chuny",
    "albion-online"
  ],
  "author": "Edwin J. Páez",
  "license": "ISC",
  "description": "Chuny BOT - Discord bot para gestión de actividades",
  "dependencies": {
    "discord.js": "^14.16.2",
    "express": "^5.1.0",
    "mongoose": "^8.0.3",
    "node-schedule": "^2.1.1"
  }
}
